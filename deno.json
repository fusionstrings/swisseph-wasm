{
  "name": "@fusionstrings/swisseph-wasm",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./wasm": "./lib/swisseph_wasm.wasm",
    "./browser": "./lib/browser/swisseph_wasm.js"
  },
  "tasks": {
    "build": "deno run -A jsr:@deno/wasmbuild",
    "build:browser": "deno run -A jsr:@deno/wasmbuild --out lib/browser --inline",
    "test": "deno test -A",
    "bench": "deno bench -A benches/comparison.ts",
    "gen": "deno run -A scripts/gen_constants.ts",
    "build:npm": "deno run -A scripts/build_npm.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.0",
    "astronomy-engine": "npm:astronomy-engine@^2.0.0"
  }
}
