{
  "name": "@fusionstrings/swisseph-wasm",
  "version": "0.1.4",
  "description": "High-precision Swiss Ephemeris bindings for WebAssembly (Rust based)",
  "exports": {
    ".": "./mod.ts",
    "./wasm": "./lib/swisseph_wasm.wasm",
    "./browser": "./lib/browser/swisseph_wasm.js"
  },
  "tasks": {
    "build": "deno task gen && deno run -A @deno/wasmbuild",
    "build:browser": "deno run -A @deno/wasmbuild --out lib/browser --inline",
    "test": "deno test -A",
    "bench": "deno bench -A benches/comparison.ts",
    "gen": "deno run -A scripts/gen_constants.ts",
    "build:npm": "deno run -A scripts/build_npm.ts",
    "check-version": "deno run -A scripts/check_version.ts",
    "bump-version": "deno run -A scripts/version_bump.ts"
  },
  "imports": {
    "@deno/wasmbuild": "jsr:@deno/wasmbuild@^0.21.0",
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/path": "jsr:@std/path@1.1.4",
    "astronomy-engine": "npm:astronomy-engine@2.1.19",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3"
  },
  "publish": {
    "include": [
      "mod.ts",
      "README.md",
      "LICENSE",
      "src/constants.ts",
      "lib/swisseph_wasm.js",
      "lib/swisseph_wasm.internal.js",
      "lib/swisseph_wasm.d.ts",
      "lib/swisseph_wasm.wasm",
      "lib/browser/swisseph_wasm.js",
      "lib/browser/swisseph_wasm.internal.js",
      "lib/browser/swisseph_wasm.d.ts"
    ],
    "exclude": [
      "!lib/**",
      "!src/constants.ts"
    ]
  },
  "license": "MIT"
}
